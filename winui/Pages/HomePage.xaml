<Page
    x:Class="IdvLauncher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:IdvLauncher.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="14,8,14,12">
        <Border x:Name="HeroBorder"
                CornerRadius="14"
                Background="#1B1A17">
            <Grid>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#D90B0A08" Offset="0" />
                            <GradientStop Color="#000B0A08" Offset="0.62" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle VerticalAlignment="Bottom" Height="250">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#000B0A08" Offset="0" />
                            <GradientStop Color="#C90B0A08" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Padding="26,20,26,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="1">
                            <TextBlock Text="IDENTITY V"
                                       CharacterSpacing="200"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="第五人格"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,1" />
                            <TextBlock Text="IDENTITY V · LAUNCHER"
                                       CharacterSpacing="150"
                                       FontSize="8.5"
                                       Foreground="#99FFFFFF" />
                            <TextBlock Text="欢迎回来，侦探。"
                                       FontSize="11.5"
                                       Foreground="#BFFFFFFF"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#88000000"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="13"
                                Padding="11,5">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse x:Name="StatusDot"
                                         Width="5"
                                         Height="5"
                                         Fill="#6FC58C"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText"
                                           Text="游戏未运行"
                                           FontSize="10"
                                           Foreground="White" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AnnouncementCard"
                                Width="416"
                                Height="184"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderBrush="#24FFFFFF"
                                Padding="14,12">
                            <Border.Background>
                                <AcrylicBrush TintColor="#101010"
                                              TintOpacity="0.55"
                                              FallbackColor="#D9100F0D" />
                            </Border.Background>
                            <Grid>
                                <Image x:Name="AnnouncementImage"
                                       Stretch="UniformToFill"
                                       Opacity="0.46"
                                       IsHitTestVisible="False" />
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#B80E0D0B" Offset="0" />
                                            <GradientStop Color="#550E0D0B" Offset="0.6" />
                                            <GradientStop Color="#C80E0D0B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse Width="4" Height="4" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="游戏公告"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock x:Name="AnnouncementSourceText"
                                                   Text="官方源"
                                                   FontSize="8.5"
                                                   Foreground="#8FFFFFFF"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="查看全部  ›"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LinkButtonStyle}"
                                            Click="OnOpenAnnouncements" />
                                </Grid>

                                <ItemsControl x:Name="AnnouncementList" Grid.Row="1" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Announcement">
                                            <Grid Height="38" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Date}"
                                                           FontSize="8.5"
                                                           Foreground="#80FFFFFF"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Title}"
                                                           FontSize="10.5"
                                                           Foreground="#E6FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        Background="#22FFFFFF"
                                                        CornerRadius="6"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Tag}"
                                                               FontSize="8"
                                                               Foreground="#B3FFFFFF"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Width="244"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="EngineQuickButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="10,5"
                                    Background="#CC000000"
                                    BorderBrush="#44FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Click="OnManualStartEngine"
                                    ToolTipService.ToolTip="登录服务未就绪时可手动启动">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="EngineStatusDot"
                                             Width="5"
                                             Height="5"
                                             Fill="#D8B36C"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="EngineStatusText"
                                               Text="登录服务未启动 · 点击启动"
                                               FontSize="10"
                                               Foreground="White" />
                                    <FontIcon x:Name="EngineQuickIcon"
                                              Glyph="&#xE768;"
                                              FontSize="9"
                                              Foreground="#BFFFFFFF" />
                                </StackPanel>
                            </Button>

                            <Border Background="#99000000"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,8">
                                <StackPanel Spacing="5">
                                    <Grid>
                                        <TextBlock Text="当前账号"
                                                   FontSize="8.5"
                                                   Foreground="#8FFFFFFF" />
                                        <TextBlock x:Name="ManualModeText"
                                                   Text="手动扫码"
                                                   HorizontalAlignment="Right"
                                                   FontSize="8.5"
                                                   Foreground="#D8B36C"
                                                   Visibility="Collapsed" />
                                    </Grid>
                                    <ComboBox x:Name="HomeAccountCombo"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="32"
                                              RequestedTheme="Dark"
                                              DisplayMemberPath="Display"
                                              SelectionChanged="OnAccountSelectionChanged"
                                              PlaceholderText="未读取到渠道账号" />
                                    <CheckBox x:Name="ManualQrCheckBox"
                                              Content="手动扫码登录（不自动选号）"
                                              FontSize="10"
                                              Foreground="#D9FFFFFF"
                                              Checked="OnManualQrChanged"
                                              Unchecked="OnManualQrChanged" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LocateGameButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="8,4"
                                        Background="#CC000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Click="OnLocateGame">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="10" />
                                        <TextBlock Text="定位游戏" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DownloadGameButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        Padding="8,4"
                                        Background="#CC000000"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Click="OnDownloadGame"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE896;" FontSize="10" />
                                        <TextBlock Text="下载游戏" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button x:Name="LaunchButton"
                                    Height="46"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="OnLaunch">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressRing x:Name="LaunchRing"
                                                  Width="18"
                                                  Height="18"
                                                  IsActive="False"
                                                  Visibility="Collapsed" />
                                    <FontIcon x:Name="LaunchIcon"
                                              Glyph="&#xE768;"
                                              FontSize="16" />
                                    <TextBlock x:Name="LaunchText"
                                               Grid.Column="1"
                                               Text="启动游戏"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="11" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>

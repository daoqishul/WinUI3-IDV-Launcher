<UserControl
    x:Class="IdvLauncher.Dialogs.AccountDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" MinWidth="480">
        <Grid>
            <TextBlock x:Name="TitleText"
                       Text="添加账号"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <Button Style="{StaticResource IconButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="OnCancel">
                <FontIcon Glyph="&#xE711;" FontSize="13" />
            </Button>
        </Grid>
        <TextBlock Text="为第五人格添加一个本地账号档案"
                   FontSize="11.5"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBox x:Name="NameBox"
                 Header="账号名称"
                 PlaceholderText="例如：小号一号"
                 MaxLength="40" />
        <ComboBox x:Name="ChannelBox"
                  Header="渠道"
                  HorizontalAlignment="Stretch"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Code" />
        <TextBox x:Name="LoginBox"
                 Header="登录账号 / UID（可选）"
                 PlaceholderText="手机号 / 渠道 UID"
                 MaxLength="80" />
        <ToggleSwitch x:Name="DefaultSwitch"
                      Header="设为默认账号"
                      OnContent=""
                      OffContent="" />
        <TextBlock x:Name="ErrorText"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <Grid ColumnSpacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="取消" Click="OnCancel" />
            <Button Grid.Column="1"
                    Content="保存"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnSave" />
        </Grid>
    </StackPanel>
</UserControl>

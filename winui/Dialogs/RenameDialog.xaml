<UserControl
    x:Class="IdvLauncher.Dialogs.RenameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" MinWidth="400">
        <TextBlock Text="重命名账号" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="只修改本机显示名称，不改变渠道登录凭据。"
                   FontSize="11.5"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <TextBox x:Name="NameBox" Header="显示名称" MaxLength="60" />
        <TextBlock x:Name="ErrorText"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <Grid ColumnSpacing="10" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="取消" Click="OnCancel" />
            <Button Grid.Column="1"
                    Content="保存"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSave" />
        </Grid>
    </StackPanel>
</UserControl>

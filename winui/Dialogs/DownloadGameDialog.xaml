<UserControl
    x:Class="IdvLauncher.Dialogs.DownloadGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12" Width="560">
        <TextBlock Text="下载第五人格"
                   FontSize="22"
                   FontWeight="SemiBold" />
        <TextBlock Text="由登录引擎多线程下载并安装。首次下载约 16–20 GB，建议选择空间充足的磁盘。"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <ComboBox x:Name="VersionCombo"
                  Header="选择版本"
                  HorizontalAlignment="Stretch"
                  DisplayMemberPath="Display"
                  PlaceholderText="正在读取版本…" />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox"
                     Header="安装目录"
                     PlaceholderText="例如 D:\IDV" />
            <Button Grid.Column="1"
                    Content="选择目录"
                    VerticalAlignment="Bottom"
                    Click="OnBrowseFolder" />
        </Grid>

        <ProgressBar x:Name="DownloadProgress"
                     Minimum="0"
                     Maximum="100"
                     Height="7"
                     Visibility="Collapsed" />
        <TextBlock x:Name="StatusText"
                   Text="选择版本和目录后开始下载。"
                   FontSize="11.5"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Text="关闭此窗口不会中断下载；引擎会继续在后台安装。"
                   FontSize="10.5"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <Grid ColumnSpacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="官方下载页" Click="OnOpenOfficial" />
            <Button x:Name="StartButton"
                    Grid.Column="1"
                    Content="开始下载"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnStart" />
            <Button Grid.Column="2"
                    Content="关闭"
                    Click="OnClose" />
        </Grid>
    </StackPanel>
</UserControl>

<Window
    x:Class="IdvLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarGrid"
              Grid.Row="0"
              Background="Transparent"
              Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock Text="IDV"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="·"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitlePageText"
                           Text="首页"
                           FontSize="11.5"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Height="1"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Grid>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="200"
                        CompactPaneLength="60"
                        IsPaneOpen="True"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        Background="{ThemeResource AppPageBackgroundBrush}"
                        PaneOpened="OnPaneOpened"
                        PaneClosed="OnPaneClosed"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="账号管理" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="云存档" Tag="cloud">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE753;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="登录引擎" Tag="engine">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="解帧" Tag="injection">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent" />
        </NavigationView>

        <InfoBar x:Name="GlobalInfoBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="True"
                 MinWidth="320"
                 MaxWidth="640"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 Margin="16" />

        <Button x:Name="FocusSink"
                Width="1"
                Height="1"
                Opacity="0"
                IsHitTestVisible="False"
                IsTabStop="True"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />

        <Grid x:Name="ModalLayer"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#A6000000">
            <Border x:Name="ModalCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="480"
                    MaxWidth="700"
                    Background="{ThemeResource ModalBackgroundBrush}"
                    BorderBrush="{ThemeResource ModalBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ContentPresenter x:Name="ModalContent" />
            </Border>
        </Grid>
    </Grid>
</Window>
